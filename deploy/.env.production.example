# AEMR production env — копируйте как .env.production и заполните реальными значениями.
# НЕ коммитить .env.production в git (он в .gitignore).

# ===== Server =====
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ===== Database =====
SQLITE_PATH=/app/packages/server/data/aemr.db

# ===== Authentication (required in production; server refuses to start if empty) =====
# Сгенерировать: openssl rand -base64 32
AEMR_API_KEY=

# ===== Google Sheets API =====
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ===== Caddy edge =====
# Режим периметра. Значение — адрес сайта для Caddy, и от него же зависит TLS.
#   ":80"                 — без шифрования, доступ по IP. Пароль периметра идёт
#                           открытым текстом: только для отладки контура.
#   "aemr.your-domain.ru" — рабочий режим: Caddy сам выпустит сертификат
#                           Let's Encrypt и сам поднимет редирект http→https.
# Перед переключением на домен: A-запись домена → IP этого сервера, порты 80 и
# 443 открыты наружу (80 нужен ACME-проверке). Подробности — deploy/README.md,
# раздел «Домен и TLS».
DOMAIN=:80

# ===== Вход по паролю на периметре =====
# Caddy закрывает basic-аутентификацией весь стенд, кроме публичного /api/health.
# Хэш генерируется так (пароль вводится в приглашении, в историю не попадает):
#   docker run --rm -it caddy:2.10-alpine caddy hash-password
# ВАЖНО: в значении ниже каждый знак «$» удваивается до «$$» — docker compose
# делает подстановку переменных и иначе съест часть хэша (дефект Д8: в контейнер
# приезжало 42 символа вместо 60, правильный пароль давал 401).
BASIC_AUTH_USER=aemr
BASIC_AUTH_HASH=

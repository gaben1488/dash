# Edge-Caddy: единая точка входа на 80/443.
# Делает reverse-proxy к web и api, и при наличии домена — авто-HTTPS Let's Encrypt.
#
# ДВА РЕЖИМА, ОДИН ФАЙЛ. Режим выбирает переменная DOMAIN из deploy/.env.production:
#
#   DOMAIN=":80"          — доступ по IP, шифрования нет. Пароль периметра идёт
#                           открытым текстом, поэтому режим годится только для
#                           отладки контура, не для работы людей.
#   DOMAIN="aemr.ru"      — Caddy сам получает сертификат Let's Encrypt, сам его
#                           продлевает и сам поднимает редирект http→https.
#
# Отдельных директив для TLS здесь нет сознательно: автоматика Caddy включается
# от того, что адрес сайта — ИМЯ, а не порт. Любая попытка описать редирект или
# issuer вручную ломала бы второй режим (для ":80" такой блок невалиден).
#
# Что обязано совпасть снаружи, иначе сертификата не будет:
#   • A-запись домена указывает на IP этого сервера;
#   • порты 80 и 443 открыты наружу (80 нужен ACME-проверке HTTP-01; закрыв его
#     «раз уж есть https», сертификат получить нельзя);
#   • том caddy_data живёт между пересборками — в нём лежат выданные сертификаты,
#     без него каждый перезапуск бил бы по лимитам выпуска Let's Encrypt.
# Проверка домена и TLS — deploy/README.md и docs/RUNBOOK.md, раздел «Домен и TLS».

{$DOMAIN} {
    encode gzip

    # HSTS — только по TLS. Условие «только при заданном домене» выполняется
    # само: в режиме ":80" защищённых соединений нет вовсе, а по открытому HTTP
    # этот заголовок слать запрещено (RFC 6797 §7.2 — браузер его всё равно
    # игнорирует). Поэтому вторая переменная окружения не нужна.
    # includeSubDomains и preload намеренно не включены: они связывают обещанием
    # все поддомены и снимаются только через год. Добавлять, когда домен точно
    # выделен под стенд и других служб на нём нет.
    @secure protocol https
    header @secure Strict-Transport-Security "max-age=31536000"

    header {
        # Тип ответа не угадывается по содержимому: JSON из /api/*, подсунутый
        # как <script>, исполняться не должен.
        X-Content-Type-Options nosniff
        # Внешним ссылкам не достаётся адрес внутренней страницы — в нём едут
        # параметры фильтров: период, ГРБС, подвед.
        Referrer-Policy no-referrer
    }

    # Вход по паролю на весь стенд, кроме двух публичных путей:
    #   /api/health        — нужен docker-healthcheck и внешнему мониторингу;
    #   /api/webhook/drive — push-уведомления Google о правках книг: Google не
    #                        умеет basic auth, приёмник защищён секретом канала
    #                        (X-Goog-Channel-Token, проверка в сервере) и отвечает
    #                        404, пока секрет не настроен.
    # Хэш пароля живёт в deploy/.env.production (BASIC_AUTH_HASH), в git его нет.
    # ACME-проверку это не задевает: Caddy обслуживает /.well-known/acme-challenge/*
    # раньше маршрутов сайта, до пароля.
    @protected {
        not path /api/health
        not path /api/webhook/drive
    }
    basic_auth @protected {
        {$BASIC_AUTH_USER:aemr} {$BASIC_AUTH_HASH}
    }

    # все /api/* → Fastify сервер.
    # Edge инжектит Bearer-токен: сервер fail-closed (требует AEMR_API_KEY),
    # браузер ключа не знает — токен живёт только на сервере (env caddy).
    handle /api/* {
        reverse_proxy server:3000 {
            header_up Authorization "Bearer {$AEMR_API_KEY}"
        }
    }

    # всё остальное → web (статика)
    handle {
        reverse_proxy web:80
    }

    log {
        output stdout
        format console
    }
}

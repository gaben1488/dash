#!/usr/bin/env sh
# Pre-commit gate (R1 из CLAUDE.md §3): блокирует коммит при tsc/test errors.
# Обход — только `--no-verify` по явной просьбе пользователя.

set -e

# server/web tsc need >4GB heap on this machine (small pagefile + parallel agents);
# without the bump the gate dies with V8 "heap out of memory" and blocks every commit.
export NODE_OPTIONS="--max-old-space-size=7168"

# Skip the TS gate when no TypeScript is staged (e.g. .py tooling, .mulch, docs, .sh).
# Rationale: the tsc/test gate exists to catch TS regressions; a non-TS commit cannot
# introduce them. Running it on a .py-only / .mulch-only commit is pure waste — and on
# this machine server-tsc OOMs under memory pressure, which silently blocked `ml sync`
# (lessons never reached the shared channel) and tooling backups. This keeps the gate
# strict for real code while unblocking data/tooling commits WITHOUT --no-verify.
STAGED_TS="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)"
if [ -z "$STAGED_TS" ]; then
  echo "[husky/pre-commit] no .ts/.tsx staged — skipping tsc/test gate"
  exit 0
fi

echo "[husky/pre-commit] typecheck all 4 packages..."
(cd packages/shared && npx tsc --noEmit) || { echo "shared tsc failed"; exit 1; }
(cd packages/core && npx tsc --noEmit) || { echo "core tsc failed"; exit 1; }
(cd packages/server && npx tsc --noEmit) || { echo "server tsc failed"; exit 1; }
(cd packages/web && npx tsc --noEmit) || { echo "web tsc failed"; exit 1; }

echo "[husky/pre-commit] running core tests..."
(cd packages/core && npx vitest run --reporter=dot) || { echo "core tests failed"; exit 1; }

echo "[husky/pre-commit] gate passed"

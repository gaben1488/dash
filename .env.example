# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Адреса, которым браузер разрешает обращаться к API, через запятую.
# Пусто — остаются адреса локальной разработки (http://localhost:5173,
# http://localhost:3000). На боевом сервере укажите адрес, по которому
# продукт открывают: AEMR_CORS_ORIGINS=https://dash-elizovo-uer.ru
AEMR_CORS_ORIGINS=

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_API_KEY=

# Database (current implementation: SQLite)
DB_PROVIDER=sqlite
SQLITE_PATH=./data/aemr.db
# DATABASE_URL is reserved for future PostgreSQL support.
DATABASE_URL=

# Auth
# Optional in development. Required when NODE_ENV=production.
AEMR_API_KEY=

# Cache
CACHE_TTL_SECONDS=300

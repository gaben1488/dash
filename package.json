{
  "name": "aemr-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently \"pnpm -F @aemr/server dev\" \"pnpm -F @aemr/web dev\"",
    "build": "pnpm -r build",
    "build:server": "pnpm -F @aemr/server build",
    "build:web": "pnpm -F @aemr/web build",
    "start": "pnpm -F @aemr/server start",
    "db:generate": "pnpm -F @aemr/server db:generate",
    "db:migrate": "pnpm -F @aemr/server db:migrate",
    "db:studio": "pnpm -F @aemr/server db:studio",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "lint:biome": "biome lint .",
    "biome:check": "biome check .",
    "biome:check:fix": "biome check --write .",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:biome": "biome format --write .",
    "typecheck": "node scripts/typecheck-workspaces.mjs",
    "typecheck:all": "pnpm -r --workspace-concurrency=1 exec tsc --noEmit",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test --watch",
    "prepare": "husky",
    "verify:braces-patch": "node scripts/verify-braces-depth-guard.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gv7w-rqvm-qjhr",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "esbuild": "^0.25.0",
      "lodash": "^4.18.1",
      "ws": "^8.20.1",
      "brace-expansion": "5.0.12",
      "shell-quote": "1.11.0",
      "fast-uri": "3.1.8",
      "qs": "6.16.0",
      "@babel/core@<=7.29.0": "7.29.6",
      "find-my-way@<=9.6.0": "9.7.0",
      "postcss@<8.5.23": "8.5.23",
      "nanoid@<3.3.18": "3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "browserslist@<4.28.7": "4.28.7",
      "@humanfs/node@<0.16.8": "0.16.8",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "undici@>=8.1.0 <8.10.2": "8.10.2",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "fast-copy@>=4.0.0 <4.1.0": "4.1.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  }
}
